# Paste your bot's token from the Discord Developer Portal (https://discord.com/developers/applications).
# Ensure you enable 'Guild Voice States' on the Bot tab.
BOT_TOKEN=

# Custom text message shown as the bot's custom status (activity text). Optional.
BOT_ACTIVITY_STATUS="Hello, earth!"

# Application runtime environment (development / production). Defaults to production.
# 'development': Enables debug-level logs.
# 'production': Logs info-level structured JSON to stdout.
APP_ENVIRONMENT=development

# Path to an FFmpeg build with libopus. Optional; defaults to 'ffmpeg' on the PATH.
# FFMPEG_PATH=/usr/bin/ffmpeg
