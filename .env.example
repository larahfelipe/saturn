# Paste your bot's token from the Discord Developer Portal (https://discord.com/developers/applications).
# Ensure you enable 'Message Content Intent' and 'Guild Voice States' on the Bot tab.
BOT_TOKEN=

# Bot prefix command trigger (e.g. !, / or ?)
BOT_COMMAND_PREFIX=!

# Custom text message shown as the bot's custom status (activity text)
BOT_ACTIVITY_STATUS="Hello, earth!"

# Application runtime environment (development / production)
# 'development': Enables verbose console logger.
# 'production': Logs structured JSON telemetry to stdout and a file.
APP_ENVIRONMENT=development
