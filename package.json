{
  "name": "saturn",
  "version": "2.0.0",
  "private": true,
  "description": "Self-hosted Discord music bot",
  "license": "GPL-3.0-only",
  "author": "Felipe Lara",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/larahfelipe/saturn.git"
  },
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/main.ts | pino-pretty",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "node --run clean && tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit --project integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:ffmpeg": "vitest run --project ffmpeg"
  },
  "dependencies": {
    "@discordjs/voice": "0.19.2",
    "@distube/ytdl-core": "5.2.1",
    "@prometheus-io/client": "0.16.1",
    "discord.js": "14.28.1",
    "pino": "10.4.0"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "@vitest/eslint-plugin": "1.6.28",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-perfectionist": "5.13.0",
    "eslint-plugin-regexp": "3.3.3",
    "eslint-plugin-unicorn": "79.0.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    }
  }
}
